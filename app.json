{
  "expo": {
    "name": "AoE3 Build Tracker",
    "slug": "aoe3-build-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "aoe3buildtracker",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0b1118",
    "ios": {
      "icon": "./assets/expo.icon",
      "supportsTablet": true,
      "bundleIdentifier": "com.aoe3buildtracker.app"
    },
    "android": {
      "package": "com.aoe3buildtracker.app",
      "adaptiveIcon": {
        "backgroundColor": "#0b1118",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "AoE3 Build Tracker",
      "shortName": "AoE3 Builds",
      "themeColor": "#0b1118",
      "backgroundColor": "#0b1118"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0b1118",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true,
      "baseUrl": "/aoe3_build_timer"
    }
  }
}
